<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Description>Extension methods that convert values between types: text to numbers, dates and booleans, one value or a whole collection at a time, with a check before converting; a list of objects to a DataTable; and a DataTable to a text table for the console.</Description>
		<Authors>WilliamSmithE</Authors>
		<PackageReadmeFile>nugetREADME.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/WilliamSmithEdward/Transformer</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/WilliamSmithEdward/Transformer</PackageProjectUrl>
		<PackageTags>convert;conversion;parse;type;extensions;collection;datatable</PackageTags>
		<Deterministic>false</Deterministic>
		<AssemblyVersion>1.0.0.5</AssemblyVersion>
		<PackageVersion>1.0.0.5</PackageVersion>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>Transformer.png</PackageIcon>
		<Copyright>William Smith (WilliamSmithE)</Copyright>
		<Title>Transformer</Title>
		<PackageId>WilliamSmithE.Transformer</PackageId>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Transformer.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="nugetREADME.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>